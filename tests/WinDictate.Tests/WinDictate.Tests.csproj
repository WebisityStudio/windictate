<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app itself targets net10.0-windows (WPF) and only runs on Windows. Its
    platform-neutral logic is compiled straight into this plain net10.0 test
    assembly instead, so the suite runs with `dotnet test` on Windows CI and on
    macOS or Linux. Native calls (user32, winmm, whisper.cpp) are declared in
    the linked files but never invoked by the tests.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>WinDictate.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\WinDictate\Core\AppSettings.cs" Link="Linked\AppSettings.cs" />
    <Compile Include="..\..\src\WinDictate\Core\CleanupService.cs" Link="Linked\CleanupService.cs" />
    <Compile Include="..\..\src\WinDictate\Core\DictationController.cs" Link="Linked\DictationController.cs" />
    <Compile Include="..\..\src\WinDictate\Core\DictationServices.cs" Link="Linked\DictationServices.cs" />
    <Compile Include="..\..\src\WinDictate\Core\HotkeyMonitor.cs" Link="Linked\HotkeyMonitor.cs" />
    <Compile Include="..\..\src\WinDictate\Core\HotkeyWatchdog.cs" Link="Linked\HotkeyWatchdog.cs" />
    <Compile Include="..\..\src\WinDictate\Core\Logger.cs" Link="Linked\Logger.cs" />
    <Compile Include="..\..\src\WinDictate\Core\MicrophoneSelector.cs" Link="Linked\MicrophoneSelector.cs" />
    <Compile Include="..\..\src\WinDictate\Core\NativeMethods.cs" Link="Linked\NativeMethods.cs" />
    <Compile Include="..\..\src\WinDictate\Core\SpeechGate.cs" Link="Linked\SpeechGate.cs" />
    <Compile Include="..\..\src\WinDictate\Core\TextInserter.cs" Link="Linked\TextInserter.cs" />
    <Compile Include="..\..\src\WinDictate\Core\Transcriber.cs" Link="Linked\Transcriber.cs" />
    <Compile Include="..\..\src\WinDictate\Core\TranscriptText.cs" Link="Linked\TranscriptText.cs" />
    <!-- The listening indicators' logic; the windows themselves are covered by tests/WinDictate.UiSmoke on Windows. -->
    <Compile Include="..\..\src\WinDictate\UI\Indicators\IDictationIndicator.cs" Link="Linked\Indicators\IDictationIndicator.cs" />
    <Compile Include="..\..\src\WinDictate\UI\Indicators\IndicatorCues.cs" Link="Linked\Indicators\IndicatorCues.cs" />
    <Compile Include="..\..\src\WinDictate\UI\Indicators\IndicatorPlacement.cs" Link="Linked\Indicators\IndicatorPlacement.cs" />
    <Compile Include="..\..\src\WinDictate\UI\Indicators\WaveformShaper.cs" Link="Linked\Indicators\WaveformShaper.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Managed API only: the tests never load a model, so no native runtime is needed. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
  </ItemGroup>

</Project>
