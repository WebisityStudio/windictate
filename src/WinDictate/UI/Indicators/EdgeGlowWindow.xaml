<Window x:Class="WinDictate.UI.Indicators.EdgeGlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDictate indicator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="560" Height="76"
        SnapsToDevicePixels="True">
    <!--
        A transparent, click-through strip resting on the top edge of the taskbar.
        The halo is the top half of a wide ellipse whose centre sits on that edge;
        the line is the bright edge itself. No shape, no words.
    -->
    <Grid x:Name="Root" Opacity="0" ClipToBounds="True">
        <Ellipse x:Name="Halo" Height="140" Margin="0,0,0,-70" VerticalAlignment="Bottom"
                 Opacity="0.25" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="0.55"/>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="HaloInner" Offset="0" Color="#8C2F7BEA"/>
                    <GradientStop x:Name="HaloMiddle" Offset="0.55" Color="#332F7BEA"/>
                    <GradientStop x:Name="HaloOuter" Offset="1" Color="#002F7BEA"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="LineHost" Height="2.5" Margin="45,0,45,0" VerticalAlignment="Bottom" ClipToBounds="True">
            <Rectangle x:Name="Line" RadiusX="1.25" RadiusY="1.25" Opacity="0.55">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="LineStart" Offset="0" Color="#002F7BEA"/>
                        <GradientStop x:Name="LineLeft" Offset="0.22" Color="#FF2F7BEA"/>
                        <GradientStop x:Name="LineCore" Offset="0.5" Color="#FFDCEBFF"/>
                        <GradientStop x:Name="LineRight" Offset="0.78" Color="#FF2F7BEA"/>
                        <GradientStop x:Name="LineEnd" Offset="1" Color="#002F7BEA"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- While working, a highlight travels along the edge. -->
            <Rectangle x:Name="Sweep" Width="120" HorizontalAlignment="Left" Opacity="0">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="SweepShift" X="0"/>
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="SweepStart" Offset="0" Color="#002F7BEA"/>
                        <GradientStop x:Name="SweepCore" Offset="0.5" Color="#FFDCEBFF"/>
                        <GradientStop x:Name="SweepEnd" Offset="1" Color="#002F7BEA"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</Window>
