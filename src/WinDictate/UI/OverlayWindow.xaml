<Window x:Class="WinDictate.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border CornerRadius="12" Padding="16,10" Background="#F21B1B1F">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse x:Name="PulseRing" Width="22" Height="22" Stroke="#FF4D6D" StrokeThickness="2" Opacity="0.0"/>
                <Ellipse x:Name="Dot" Width="12" Height="12" Fill="#FF4D6D" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Listening…" Foreground="White"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="TargetText" Text="" Foreground="#9AA0A6"
                           FontFamily="Segoe UI" FontSize="11" Margin="0,1,0,0"/>
            </StackPanel>
            <Border x:Name="MeterTrack" Width="60" Height="6" CornerRadius="3" Background="#33FFFFFF"
                    VerticalAlignment="Center" Margin="14,0,0,0" HorizontalAlignment="Left">
                <Border x:Name="MeterFill" Width="0" Height="6" CornerRadius="3" Background="#4CD964"
                        HorizontalAlignment="Left"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
